# Get this from @BotFather on Telegram
BOT_TOKEN=

# Your personal Telegram user ID (daily reports + /report go here).
# Get it by messaging @userinfobot
ADMIN_ID=

# Provided automatically by Railway's Postgres plugin — copy its
# DATABASE_URL reference variable here, or leave as-is if you link the
# plugin so Railway injects it for you.
DATABASE_URL=

# How often (minutes) to ping an on-shift clipper for a status check
CHECKIN_INTERVAL_MINUTES=30

# How long (minutes) a clipper has to press the button before it counts as missed
CHECKIN_GRACE_MINUTES=5

# Cron expression (in TZ below) for the admin daily report. Default: midnight.
DAILY_REPORT_CRON=0 0 * * *

# Timezone used for displaying times and scheduling the daily report
TZ=Europe/Stockholm
